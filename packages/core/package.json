{
  "name": "@louismax/cn-area-cascader-core",
  "version": "0.1.0",
  "description": "China area tree data and framework-agnostic utilities.",
  "author": "louismax",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/louismax/cn-area-cascader.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/louismax/cn-area-cascader#readme",
  "bugs": {
    "url": "https://github.com/louismax/cn-area-cascader/issues"
  },
  "keywords": [
    "china",
    "area",
    "province",
    "city",
    "district",
    "region",
    "cascader",
    "china-area",
    "area-data",
    "administrative-division",
    "selected-collapse",
    "parent-collapse",
    "省市区",
    "中国省市区",
    "行政区划",
    "地区数据",
    "省市区数据",
    "多选折叠父级"
  ],
  "type": "module",
  "main": "dist/index.umd.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    },
    "./full": {
      "types": "./dist/full.d.ts",
      "import": "./dist/full.js"
    },
    "./data": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    },
    "./data/china-area-tree.json": "./src/data/china-area-tree.json",
    "./data/china-area-tree.full.json": "./src/data/china-area-tree.full.json"
  },
  "files": [
    "dist",
    "src/data",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "vite": "^6.0.3",
    "typescript": "^5.7.2"
  }
}
