{
  "name": "@louismax/cn-area-cascader-vue2",
  "version": "0.1.0",
  "description": "China province city district cascader for Vue 2 and Element UI.",
  "type": "module",
  "main": "dist/index.umd.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@louismax/cn-area-cascader-core": "0.1.0"
  },
  "peerDependencies": {
    "element-ui": "^2.15.0",
    "vue": "^2.7.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "element-ui": "^2.15.14",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "@vitejs/plugin-vue2": "^2.3.1",
    "vue": "^2.7.16",
    "vue-template-compiler": "^2.7.16"
  }
}
