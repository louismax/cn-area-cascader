{
  "name": "@louismax/cn-area-cascader-vue2",
  "version": "0.1.0",
  "description": "China province city district cascader for Vue 2 and Element UI.",
  "author": "louismax",
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/louismax/cn-area-cascader.git",
    "directory": "packages/vue2"
  },
  "homepage": "https://github.com/louismax/cn-area-cascader#readme",
  "bugs": {
    "url": "https://github.com/louismax/cn-area-cascader/issues"
  },
  "keywords": [
    "vue",
    "vue2",
    "element-ui",
    "cascader",
    "area-cascader",
    "china-area",
    "province",
    "city",
    "district",
    "region-selector",
    "multi-select",
    "selected-collapse",
    "parent-collapse",
    "collapse-selected",
    "省市区",
    "省市区联动",
    "省市区选择器",
    "三级联动",
    "三级级联",
    "行政区划",
    "地区选择器",
    "城市选择器",
    "级联选择",
    "多选折叠父级",
    "多选区域折叠"
  ],
  "type": "module",
  "main": "dist/index.umd.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@louismax/cn-area-cascader-core": "0.1.0"
  },
  "peerDependencies": {
    "element-ui": "^2.15.0",
    "vue": "^2.7.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "element-ui": "^2.15.14",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "@vitejs/plugin-vue2": "^2.3.1",
    "vue": "^2.7.16",
    "vue-template-compiler": "^2.7.16"
  }
}
