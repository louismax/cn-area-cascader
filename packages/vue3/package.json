{
  "name": "@louismax/cn-area-cascader",
  "version": "0.1.0",
  "description": "China province city district cascader for Vue 3 and Element Plus.",
  "type": "module",
  "main": "dist/index.umd.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@louismax/cn-area-cascader-core": "0.1.0"
  },
  "peerDependencies": {
    "element-plus": "^2.0.0",
    "vue": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "element-plus": "^2.9.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vue": "^3.5.13"
  }
}
