{
  "name": "cn-area-cascader-workspace",
  "version": "0.0.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "author": "louismax",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/louismax/cn-area-cascader.git"
  },
  "homepage": "https://github.com/louismax/cn-area-cascader#readme",
  "bugs": {
    "url": "https://github.com/louismax/cn-area-cascader/issues"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "yarn build:core && yarn build:vue3 && yarn build:vue2",
    "build:core": "yarn workspace @louismax/cn-area-cascader-core build",
    "build:vue3": "yarn workspace @louismax/cn-area-cascader build",
    "build:vue2": "yarn workspace @louismax/cn-area-cascader-vue2 build",
    "build:demo": "yarn workspace example-vue3 build",
    "dev:vue3": "yarn workspace example-vue3 dev"
  },
  "devDependencies": {}
}
