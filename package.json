{
  "name": "cn-area-cascader-workspace",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "yarn build:core && yarn build:vue3 && yarn build:vue2",
    "build:core": "yarn workspace @louismax/cn-area-cascader-core build",
    "build:vue3": "yarn workspace @louismax/cn-area-cascader build",
    "build:vue2": "yarn workspace @louismax/cn-area-cascader-vue2 build",
    "dev:vue3": "yarn workspace example-vue3 dev"
  },
  "devDependencies": {}
}
